generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  PENDING
  ACTIVE
  APPROVED
  INACTIVE
  REJECTED
  SUSPENDED
}

enum UserRole {
  ADMIN
  VOTER
  OFFICIAL
  OBSERVER
}

enum ElectionStatus {
  DRAFT
  OPEN
  CLOSED
  ARCHIVED
}

enum BallotType {
  SINGLE_CHOICE
  MULTIPLE_CHOICE
}

enum IdType {
  NATIONAL_CARD
  NATIONAL_ID
  SCHOOL_ID
  PASSPORT
  DRIVER_LICENSE
}

enum VerificationMode {
  MANUAL_ADMIN_REVIEW
  ID_DOCUMENT_OCR
  FACIAL_RECOGNITION
  SMS_OTP
  EMAIL_VERIFICATION
  THIRD_PARTY_KYC
}

model User {
  id            String     @id @default(cuid())
  email         String?    @unique
  name          String
  password_hash String?
  role          UserRole   @default(VOTER)
  status        UserStatus @default(PENDING)
  created_at    DateTime   @default(now())
  updated_at    DateTime   @updatedAt

  voter_registration VoterRegistration?
  created_elections  Election[]          @relation("CreatedBy")
  audit_logs         AuditLog[]          @relation("ActorLogs")
  votes              Vote[]

  @@map("users")
}

model VoterRegistration {
  id                String            @id @default(cuid())
  user_id           String?           @unique
  voter_id          String            @unique
  idType            IdType?
  lookupKey         String?           @db.VarChar(128)
  hashedIdValue     String?
  idDocumentUrl     String?
  
  verificationMode  VerificationMode?
  verificationData  Json?             
  verifiedAt        DateTime?

  approved_at       DateTime?
  approved_by       String?
  created_at        DateTime          @default(now())
  updated_at        DateTime          @updatedAt

  user User? @relation(fields: [user_id], references: [id], onDelete: SetNull)

  @@unique([idType, lookupKey], name: "unique_idtype_lookupkey")
  @@map("voter_registrations")
}

model Election {
  id          String         @id @default(cuid())
  title       String
  description String?
  start_at    DateTime
  end_at      DateTime
  status      ElectionStatus @default(DRAFT)
  created_by  String
  created_at  DateTime       @default(now())
  updated_at  DateTime       @updatedAt

  creator    User       @relation("CreatedBy", fields: [created_by], references: [id], onDelete: Cascade)
  ballots    Ballot[]
  votes      Vote[]
  audit_logs AuditLog[] @relation("ElectionAuditLogs")

  @@map("elections")
}

model Ballot {
  id          String     @id @default(cuid())
  election_id String
  title       String
  type        BallotType @default(SINGLE_CHOICE)
  created_at  DateTime   @default(now())
  updated_at  DateTime   @updatedAt

  election Election @relation(fields: [election_id], references: [id], onDelete: Cascade)
  options  Option[]
  votes    Vote[]

  @@map("ballots")
}

model Option {
  id         String   @id @default(cuid())
  ballot_id  String
  label      String
  metadata   Json?
  created_at DateTime @default(now())

  ballot Ballot @relation(fields: [ballot_id], references: [id], onDelete: Cascade)
  votes  Vote[]

  @@map("options")
}

model Vote {
  id          String   @id @default(cuid())
  election_id String
  ballot_id   String
  option_id   String
  voter_id    String
  user_id     String?
  created_at  DateTime @default(now())

  election Election @relation(fields: [election_id], references: [id], onDelete: Cascade)
  ballot   Ballot   @relation(fields: [ballot_id], references: [id], onDelete: Cascade)
  option   Option   @relation(fields: [option_id], references: [id], onDelete: Cascade)
  user     User?    @relation(fields: [user_id], references: [id], onDelete: SetNull)

  @@unique([election_id, voter_id])
  @@map("votes")
}

model AuditLog {
  id          String    @id @default(cuid())
  actor_id    String?
  actor_role  UserRole?
  action      String    
  target_type String?   
  target_id   String?
  election_id String?   // Explicit key for Election relation
  details     Json?
  created_at  DateTime  @default(now())

  actor    User?     @relation("ActorLogs", fields: [actor_id], references: [id], onDelete: SetNull)
  election Election? @relation("ElectionAuditLogs", fields: [election_id], references: [id], onDelete: SetNull)

  @@map("audit_logs")
}
